FROM python:3.12-slim
RUN pip install --no-cache-dir mlflow==3.1.4
# MLflow 3.1 imports a pool removed in SQLAlchemy 2.1.
RUN pip install --no-cache-dir SQLAlchemy==2.0.43
WORKDIR /mlflow
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:////mlflow/mlflow.db", "--serve-artifacts", "--artifacts-destination", "/mlflow/artifacts"]
